<Page x:Class="Variant10.Pages.PageTask4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 4" FontFamily="Times New Roman" FontSize="16">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" FontWeight="Bold"
                   Text="Задача 4. Поменять местами первое простое и первое совершенное числа в массиве."/>

        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
            <TextBlock Text="Размер N:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtN" Width="60" Text="10" Margin="10,0,0,0"/>
            <Button x:Name="btnGenerate" Content="Сгенерировать" Width="150" Height="35"
                    Margin="15,0,0,0" Click="btnGenerate_Click"/>
            <Button x:Name="btnCalculate" Content="Выполнить" Width="150" Height="35"
                    Margin="15,0,0,0" Click="btnCalculate_Click"/>
        </StackPanel>

        <TextBlock Text="Массив (числа через пробел):" Margin="0,15,0,5"/>
        <TextBox x:Name="txtArray" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>

        <TextBlock Text="Результат:" Margin="0,15,0,5"/>
        <TextBox x:Name="txtResult" Height="140" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
    </StackPanel>
</Page>
