<Page x:Class="Variant10.Pages.PageTask2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 2" FontFamily="Times New Roman" FontSize="16">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" FontWeight="Bold"
                   Text="Задача 2. Дана строка-предложение на русском языке. Вывести самое длинное слово в предложении (если таких слов несколько, то вывести первое из них)."/>

        <TextBlock Text="Введите предложение:" Margin="0,15,0,5"/>
        <TextBox x:Name="txtInput"/>

        <Button x:Name="btnCalculate" Content="Выполнить" Width="150" Height="35"
                HorizontalAlignment="Left" Margin="0,10,0,0" Click="btnCalculate_Click"/>

        <TextBlock Text="Результат:" Margin="0,15,0,5"/>
        <TextBox x:Name="txtResult" Height="150" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/>
    </StackPanel>
</Page>
